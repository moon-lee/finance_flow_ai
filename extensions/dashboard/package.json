{
  "name": "dashboard",
  "version": "0.1.0",
  "description": "Dashboard extension (Phase 5: aggregator landing view).",
  "private": true,
  "main": "src/main.ts",
  "financeExtension": {
    "id": "dashboard",
    "displayName": "Dashboard",
    "version": "0.1.0",
    "main": "src/main.ts",
    "description": "Default landing view aggregating net worth, YTD salary, last payslip, and accounts.",
    "dependencies": ["salary-history"],
    "activationEvents": ["onStartup"],
    "contributions": {
      "views": [
        {
          "id": "dashboard-view",
          "name": "Dashboard",
          "icon": "D",
          "openCommand": "dashboard.refresh"
        }
      ],
      "commands": [
        {
          "id": "dashboard.refresh",
          "title": "Refresh Dashboard"
        },
        {
          "id": "dashboard.open-net-worth-detail",
          "title": "Net Worth Detail"
        }
      ],
      "navigation": [
        {
          "id": "dashboard-refresh",
          "label": "Refresh",
          "command": "dashboard.refresh",
          "group": "Quick Links"
        },
        {
          "id": "dashboard-net-worth",
          "label": "Net Worth Detail",
          "command": "dashboard.open-net-worth-detail",
          "group": "Insights"
        },
        {
          "id": "dashboard-open-salary",
          "label": "Open Salary History",
          "command": "salary.show-pay-history",
          "group": "Insights"
        }
      ],
      "allowedCommands": ["dashboard.refresh", "dashboard.open-net-worth-detail"],
      "allowedUiEvents": ["dashboard-refresh", "card-order-change"],
      "configuration": [
        {
          "key": "dashboard.financialYearStart",
          "type": "string",
          "label": "Financial year start (MM-DD)",
          "default": "07-01",
          "pattern": "^\\d{2}-\\d{2}$",
          "formatHint": "MM-DD",
          "placeholder": "07-01"
        },
        {
          "key": "dashboard.financeYear",
          "type": "string",
          "label": "Financial year label override (e.g. 2025-2026). Empty = auto-compute.",
          "default": "",
          "pattern": "^\\d{4}-\\d{4}$",
          "formatHint": "YYYY-YYYY",
          "placeholder": "2025-2026"
        }
      ]
    }
  }
}
