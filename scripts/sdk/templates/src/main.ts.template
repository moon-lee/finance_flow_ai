import type { FinanceApi } from 'finance';
import { ExtensionLogger } from 'finance-logger';
const logger = new ExtensionLogger('{{ID}}');
if (typeof window !== 'undefined') { import('./ui/index.js').catch(()=>{}); }
export function registerUIComponents(): void {}
export function activate(finance: FinanceApi, ctx: { viewId?: string } = {}): void {
  logger.info('activate {{ID}}', { viewId: ctx.viewId });
  finance.commands.registerCommand('{{ID}}.hello', '{{DISPLAY_NAME}}: Hello', () => {
    finance.ui?.requestMount('{{ID}}', { greeting: 'Hello from {{ID}}' });
  });
  if (ctx.viewId && typeof document !== 'undefined') {
    const app = document.getElementById('app');
    if (app) {
      const viewEl = document.createElement('{{ID}}-view');
      app.innerHTML = '';
      app.appendChild(viewEl);
    }
  }
}
export function deactivate(): void { logger.info('deactivate {{ID}}'); }
