{
  "name": "finance_flow_ai",
  "productName": "Finance Flow AI",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main/main.js",
  "scripts": {
    "pretest": "node scripts/rebuild-better-sqlite3-node.mjs",
    "test": "vitest run",
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:preload\" \"npm:dev:extension-host\" \"npm:dev:extensions\" \"npm:dev:panel-resources\" \"npm:dev:renderer\" \"npm:start:dev\"",
    "dev:main": "vite build --config vite.main.config.ts --watch",
    "dev:preload": "vite build --config vite.preload.config.ts --watch",
    "dev:extension-host": "vite build --config vite.extension-host.config.ts --watch",
    "dev:extensions": "vite build --config vite.extensions.config.ts --watch",
    "dev:panel-resources": "vite build --config vite.panel-resources.config.ts --watch",
    "dev:renderer": "vite --config vite.config.ts",
    "start:dev": "wait-on http://127.0.0.1:5173 dist/main/main.js dist/preload/preload.cjs dist/extension-host/host.js dist/extensions/salary-history.js dist/resources/panel-bootstrap.js && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 nodemon --watch dist/main/main.js --watch dist/preload/preload.cjs --watch dist/extension-host/host.js --exec \"electron dist/main/main.js\"",
    "start": "npm run build && electron dist/main/main.js",
    "build": "npm run build:main && npm run build:resources && npm run build:preload && npm run build:extension-host && npm run build:extensions && npm run build:renderer",
    "build:main": "vite build --config vite.main.config.ts",
    "build:resources": "vite build --config vite.panel-resources.config.ts && node -e \"require('node:fs').cpSync('src/main/resources/panel-template.html','dist/resources/panel-template.html')\"",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:extension-host": "vite build --config vite.extension-host.config.ts",
    "build:extensions": "vite build --config vite.extensions.config.ts && node scripts/rename-extension-bundles.mjs",
    "build:renderer": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test --config playwright.electron.config.ts",
    "package:local": "npm run build && electron-builder --win dir && npm run deploy:local",
    "deploy:local": "node scripts/deploy-local.mjs",
    "rebuild": "electron-rebuild --force",
    "test:unit:watch": "vitest",
    "version:bump": "node scripts/version-bump.mjs",
    "sdk:init": "node scripts/sdk/cli.mjs init",
    "sdk:build": "node scripts/sdk/cli.mjs build",
    "postinstall": "electron-rebuild --force"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "extract-zip": "^2.0.1",
    "lit": "^3.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.6",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.financeflowai.desktop",
    "productName": "Finance Flow AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "dist/extensions",
        "to": "dist/extensions"
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "icon.png",
          "icon.ico"
        ]
      },
      {
        "from": "extensions",
        "to": "extensions",
        "filter": [
          "**/package.json"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.ico"
    }
  }
}
